OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# AWS Bedrock (only needed when MODEL uses a bedrock_converse:* model)
# Credentials are read from ~/.aws/credentials — do NOT put them in .env
AWS_REGION=us-east-1

YOLO_SERVICE_URL=http://localhost:8080

MODEL=bedrock_converse:anthropic.claude-3-haiku-20240307-v1:0
