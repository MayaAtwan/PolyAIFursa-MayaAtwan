OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

YOLO_SERVICE_URL=http://localhost:8080

# AWS — used for S3 image hand-off and/or Bedrock models
AWS_REGION=us-east-1
AWS_S3_BUCKET=maya-polyai-images
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the standard AWS credential chain

MODEL=openai:gpt-5.4-mini
