OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# AWS — Bedrock models (when MODEL uses bedrock_converse:*) and S3 image hand-off to YOLO
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=maya-polyai-images

YOLO_SERVICE_URL=http://localhost:8080

MODEL=bedrock_converse:anthropic.claude-3-haiku-20240307-v1:0
