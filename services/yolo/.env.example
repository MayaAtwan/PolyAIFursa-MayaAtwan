# AWS S3 — where the YOLO service reads original images and writes predicted ones.
AWS_REGION=us-east-1
AWS_S3_BUCKET=maya-polyai-images
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the standard AWS credential chain

# Object detection confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# Database backend: "sqlite" (default) or "postgres"
DB_BACKEND=sqlite
# Only used when DB_BACKEND=postgres:
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=predictions
