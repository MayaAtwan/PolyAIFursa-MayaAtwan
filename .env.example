# Root .env.example — copy this to .env and fill in your values.
# The actual .env is never committed to git (add .env to .gitignore).
# CI updates this file on the server automatically before each docker compose up.

# ── DockerHub ─────────────────────────────────────────────────────────────────
# Your DockerHub username (the account where images are pushed)
DOCKERHUB_USERNAME=your_dockerhub_username

# ── Image Tags ────────────────────────────────────────────────────────────────
# Set to a git commit SHA or timestamp — never 'latest'.
# CI workflows update the relevant tag on each deploy.
# Locally, build images with a tag (e.g. 'test') and set that here.
YOLO_IMAGE_TAG=latest
AGENT_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
MCP_IMAGE_TAG=latest
